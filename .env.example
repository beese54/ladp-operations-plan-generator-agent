# =============================================================
# Water Network Operations Plan Generator — Environment Config
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Together.ai (OpenAI-compatible API) ---
TOGETHER_API_KEY=...
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Neo4j Aura ---
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- SQLite Calendar DB ---
SQLITE_DB_PATH=./data/calendar.db

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM Provider per agent (anthropic | together) ---
# Override individual agents here if needed. Defaults are set in config/settings.py.
# AGENT_PROVIDER_SOP_AGENT=anthropic
# AGENT_PROVIDER_HISTORICAL_AGENT=anthropic
# AGENT_PROVIDER_GENERAL_RESPONSE=anthropic
